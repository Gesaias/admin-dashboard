{
  "name": "admin-dashboard",
  "scripts": {
    "i:all": "pnpm install",
    "backend": "pnpm -F admin-dashboard-backend",
    "frontend": "pnpm -F admin-dashboard-frontend",
    "shared": "pnpm -F admin-dashboard-shared",
    "start:frontend": "pnpm -F admin-dashboard-frontend dev",
    "start:backend": "pnpm -F admin-dashboard-backend start:dev",
    "backend:dev": "pnpm -F admin-dashboard-backend start:dev",
    "backend:build": "pnpm -F admin-dashboard-backend build",
    "backend:db:migrate": "pnpm -F admin-dashboard-backend db:migrate",
    "backend:db:clean": "pnpm -F admin-dashboard-backend db:clean",
    "backend:db:seed": "pnpm -F admin-dashboard-backend db:seed",
    "backend:db:gen": "pnpm -F admin-dashboard-backend db:generate"
  }
}